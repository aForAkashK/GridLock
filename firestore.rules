rules_version = '2';

/**
 * Firestore security rules for Freeway Escape.
 *
 * Deploy with:  firebase deploy --only firestore:rules
 *
 * The whole model: a player may read and write exactly one document, their
 * own. There is no shared or public data in the app, so anything broader is
 * strictly a liability.
 *
 * Note on trust: these rules stop a player touching SOMEONE ELSE'S balance.
 * They cannot stop a player editing their OWN balance, because the client is
 * authoritative over coins by design (DECISIONS.md D-004). Direct Android
 * checkout verifies purchase signatures on the device and keeps this trust
 * model (D-034).
 */
service cloud.firestore {

  // `is number`, not `is int`: JS has one number type, and whether the client
  // SDK encodes 110 as an integer or a double is its choice. `is int` would
  // reject every write the moment it picks double.
  //
  // Progress fields are optional (older documents predate them) but, when
  // present, must be the right shape. The size cap stops a bad or malicious
  // client from bloating the document toward Firestore's 1 MiB limit.
  function isValidPlayerDoc(data) {
    return data.coins is number
           && data.coins >= 0
           && data.syncVersion is number
           && data.syncVersion >= 0
           && (!('completedLevels' in data)
               || (data.completedLevels is list
                   && data.completedLevels.size() <= 2000))
           && (!('currentLevel' in data)
               || (data.currentLevel is number && data.currentLevel >= 1));
  }

  match /databases/{database}/documents {

    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
                  && !exists(/databases/$(database)/documents/deletedPlayers/$(uid));

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !existsAfter(/databases/$(database)/documents/deletedPlayers/$(uid))
                    && isValidPlayerDoc(request.resource.data);

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !existsAfter(/databases/$(database)/documents/deletedPlayers/$(uid))
                    && isValidPlayerDoc(request.resource.data)
                    // syncVersion is monotonic. Rejecting a stale or replayed
                    // write here means a second device cannot roll the balance
                    // backwards, which is the same rule the client merge uses.
                    && request.resource.data.syncVersion
                       >= resource.data.syncVersion;

      // Only owner deletion with the durable anti-resurrection marker.
      allow delete: if request.auth != null && request.auth.uid == uid
                    && existsAfter(/databases/$(database)/documents/deletedPlayers/$(uid));
    }

    match /deletedPlayers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['deletedAt'])
                    && request.resource.data.deletedAt == request.time;
      allow update, delete: if false;
    }

    // Everything else is closed. New collections must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

