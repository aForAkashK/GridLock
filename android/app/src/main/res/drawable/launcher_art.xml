<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive layers have 108 units; the visible mask covers the central 72.
     Fit the existing square artwork to that viewport rather than cropping the car. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16.6667%"
    android:insetTop="16.6667%"
    android:insetRight="16.6667%"
    android:insetBottom="16.6667%">
    <bitmap android:src="@drawable/launcher_image" android:gravity="fill" />
</inset>
