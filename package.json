{
  "name": "GridLock",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "validate:levels": "tsx tools/level-tools/validate-levels.ts",
    "pods": "cd ios && USE_FRAMEWORKS=static pod install",
    "stamp:par": "tsx tools/level-tools/stamp-par.ts",
    "generate:levels": "tsx tools/level-tools/generate-levels.ts",
    "bench:hints": "tsx tools/level-tools/bench-hints.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run validate:levels"
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/react-native-skia": "^2.11.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-worklets": "^0.12.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
